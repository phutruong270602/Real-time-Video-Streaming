<Window x:Class="WindowsRtspReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Optitrack iPhone RTSP Receiver" Height="820" Width="1440"
        MinHeight="680" MinWidth="1180" Background="#111827"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,12"
                Background="#020617" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Video Display" Foreground="White"
                           FontSize="17" FontWeight="SemiBold" Margin="16,12" />
                <Grid Grid.Row="1" Margin="12,0">
                    <wv2:WebView2 x:Name="WebRtcVideoView" Visibility="Collapsed" />
                    <Image x:Name="VideoImage" Stretch="Uniform" />
                    <Border x:Name="VideoPlaceholder" Background="#99020617">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="VideoPlaceholderTitle" Text="Waiting for iPhone video"
                                       Foreground="#CBD5E1" FontSize="20"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="VideoPlaceholderMessage" Text="Connect the iPhone, then press Start"
                                       Foreground="#94A3B8" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ImpactControlsPanel"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,12" Padding="10,8"
                            Background="#E11F2937" CornerRadius="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="ImpactButton" Content="Impact (I)"
                                        MinWidth="100" Padding="10,6"
                                        Click="ImpactButton_Click" />
                                <TextBlock x:Name="ImpactStatusText"
                                           Text="Waiting for 2 seconds of live video."
                                           Foreground="White" VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="ReviewControlsPanel" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Visibility="Collapsed"
                                        Margin="0,8,0,0">
                                <Button x:Name="NewReviewButton" Content="New"
                                        MinWidth="56" Margin="0,0,6,0" Padding="8,4"
                                        Click="NewReviewButton_Click" />
                                <Button x:Name="PreviousFrameButton" Content="◀"
                                        MinWidth="42" Margin="0,0,6,0" Padding="8,4"
                                        ToolTip="Previous frame"
                                        Click="PreviousFrameButton_Click" />
                                <Button x:Name="PlayReviewButton" Content="Play"
                                        MinWidth="56" Margin="0,0,6,0" Padding="8,4"
                                        Click="PlayReviewButton_Click" />
                                <Button x:Name="NextFrameButton" Content="▶"
                                        MinWidth="42" Margin="0,0,8,0" Padding="8,4"
                                        ToolTip="Next frame"
                                        Click="NextFrameButton_Click" />
                                <TextBlock x:Name="ReviewFrameText" Text="Frame 0 / 0"
                                           Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding VideoSize}" Foreground="#94A3B8"
                           Margin="16,8" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,12,12" Padding="16"
                Background="#1F2937" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Streaming Configuration" Foreground="White"
                               FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Text="Video source" Foreground="#CBD5E1" />
                    <ComboBox x:Name="ReceiverModeComboBox" SelectedIndex="0" IsEnabled="False"
                              Margin="0,6,0,12">
                        <ComboBoxItem Content="RTSP URL" />
                    </ComboBox>
                    <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Resolution" Foreground="#CBD5E1" />
                    <ComboBox x:Name="ResolutionComboBox"
                              ItemsSource="{Binding Resolutions}"
                              SelectedItem="{Binding SelectedResolution, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanConfigureSource}" Margin="0,6,0,12"
                              SelectionChanged="ResolutionComboBox_SelectionChanged" />
                    <TextBlock Text="Target frame rate" Foreground="#CBD5E1" />
                    <ComboBox x:Name="FrameRateComboBox"
                              ItemsSource="{Binding FrameRates}"
                              SelectedItem="{Binding SelectedFrameRate, UpdateSourceTrigger=PropertyChanged}"
                              ItemStringFormat="{}{0} FPS"
                              IsEnabled="{Binding CanConfigureSource}" Margin="0,6,0,6"
                              SelectionChanged="FrameRateComboBox_SelectionChanged" />
                    <TextBlock Text="Available rates depend on resolution and camera."
                               Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="Camera" Foreground="#CBD5E1" />
                    <ComboBox x:Name="CameraComboBox"
                              ItemsSource="{Binding Cameras}"
                              SelectedItem="{Binding SelectedCamera, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanConfigureSource}" Margin="0,6,0,12"
                              SelectionChanged="CameraComboBox_SelectionChanged" />
                    <TextBlock Text="Target bitrate" Foreground="#CBD5E1" />
                    <Slider x:Name="TargetBitrateSlider" Minimum="2" Maximum="30"
                            Value="{Binding TargetBitrateMbps, UpdateSourceTrigger=PropertyChanged}"
                            TickFrequency="1" IsSnapToTickEnabled="False"
                            IsEnabled="{Binding CanConfigureSource}" Margin="0,8,0,0"
                            ValueChanged="TargetBitrateSlider_ValueChanged" />
                    <TextBlock Text="{Binding TargetBitrateLabel}" Foreground="#94A3B8"
                               HorizontalAlignment="Right" Margin="0,2,0,16" />
                    </StackPanel>
                    <StackPanel x:Name="RtspSettingsPanel">
                        <TextBlock Text="RTSP servers on this network" Foreground="#CBD5E1" />
                        <Button x:Name="DiscoverRtspServersButton"
                                Content="Find iPhone RTSP server"
                                Margin="0,6,0,6" Padding="8,6"
                                Click="DiscoverRtspServersButton_Click" />
                        <ListBox x:Name="DiscoveredRtspServersListBox"
                                 DisplayMemberPath="DisplayName"
                                 SelectionChanged="DiscoveredRtspServersListBox_SelectionChanged"
                                 Height="72" Margin="0,0,0,12"
                                 Background="#111827" Foreground="White"
                                 BorderBrush="#475569"
                                 ToolTip="Select a discovered iPhone to fill in its RTSP URL." />
                        <TextBlock Text="{Binding ControlStatus}" Foreground="#CBD5E1"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="RTSP URL" Foreground="#CBD5E1" />
                        <TextBox x:Name="RtspUrlTextBox" Margin="0,6,0,12"
                                 Padding="8" Text="rtsp://" />
                        <TextBlock Text="Use the same URL with OptitrackCameraDLL. The iPhone server provides RTSP video and camera-control HTTP endpoints on TCP port 554."
                                   Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="Transport" Foreground="#CBD5E1" />
                        <ComboBox x:Name="TransportComboBox" SelectedIndex="0" Margin="0,6,0,16">
                            <ComboBoxItem Content="UDP" />
                            <ComboBoxItem Content="TCP" />
                        </ComboBox>
                        <TextBlock Text="Connection timeout" Foreground="#CBD5E1" />
                        <ComboBox x:Name="TimeoutComboBox" SelectedIndex="1" Margin="0,6,0,12">
                            <ComboBoxItem Content="2 seconds" Tag="2000" />
                            <ComboBoxItem Content="5 seconds" Tag="5000" />
                            <ComboBoxItem Content="10 seconds" Tag="10000" />
                            <ComboBoxItem Content="20 seconds" Tag="20000" />
                        </ComboBox>
                        <CheckBox x:Name="ReconnectCheckBox" Content="Automatically reconnect"
                                  IsChecked="True" Foreground="#CBD5E1" Margin="0,2,0,8"
                                  Checked="ReconnectCheckBox_Changed"
                                  Unchecked="ReconnectCheckBox_Changed" />
                        <TextBlock Text="Reconnect delay" Foreground="#CBD5E1" />
                        <ComboBox x:Name="ReconnectDelayComboBox" SelectedIndex="1" Margin="0,6,0,12">
                            <ComboBoxItem Content="0.5 seconds" Tag="500" />
                            <ComboBoxItem Content="1 second" Tag="1000" />
                            <ComboBoxItem Content="2 seconds" Tag="2000" />
                            <ComboBoxItem Content="5 seconds" Tag="5000" />
                        </ComboBox>
                        <TextBlock Text="Encoded packet queue" Foreground="#CBD5E1" />
                        <ComboBox x:Name="QueueCapacityComboBox" SelectedIndex="1" Margin="0,6,0,16">
                            <ComboBoxItem Content="10 packets" Tag="10" />
                            <ComboBoxItem Content="30 packets" Tag="30" />
                            <ComboBoxItem Content="60 packets" Tag="60" />
                            <ComboBoxItem Content="120 packets" Tag="120" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="Start" MinWidth="100"
                                Margin="0,0,8,0" Padding="10,6" Click="StartButton_Click" />
                        <Button x:Name="StopButton" Content="Stop" MinWidth="100"
                                Padding="10,6" IsEnabled="False" Click="StopButton_Click" />
                    </StackPanel>

                    <TextBlock Text="Connection" Foreground="#CBD5E1"
                               FontWeight="SemiBold" Margin="0,20,0,4" />
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Codec" Foreground="#CBD5E1"
                               FontWeight="SemiBold" Margin="0,14,0,4" />
                    <TextBlock Text="{Binding Codec}" Foreground="White" />
                    <TextBlock Text="RTSP source" Foreground="#CBD5E1"
                               FontWeight="SemiBold" Margin="0,14,0,4" />
                    <TextBlock Text="The iPhone RTSP sender can provide capture FPS, encode FPS, and bitrate over UDP 8556."
                               Foreground="#94A3B8" TextWrapping="Wrap" />
                    <TextBlock Text="Video diagnostics" Foreground="#CBD5E1"
                               FontWeight="SemiBold" Margin="0,18,0,4" />
                    <TextBlock Text="{Binding Diagnostic}" Foreground="#94A3B8"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LastError}" Foreground="#FCA5A5"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Padding="16"
                Background="#1F2937" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Performance Monitoring" Foreground="White"
                               FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Text="Receive rate (packets/s)" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding ReceiveFps}" Foreground="White"
                               FontSize="22" Margin="0,2,0,12" />
                    <TextBlock Text="Decode FPS" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding DecodeFps}" Foreground="{Binding DecodeFpsForeground}"
                               FontSize="22" Margin="0,2,0,12" />
                    <TextBlock Text="Render FPS" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding RenderFps}" Foreground="{Binding RenderFpsForeground}"
                               FontSize="22" Margin="0,2,0,12" />
                    <TextBlock Text="Capture / encode FPS (source)" Foreground="#94A3B8" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Margin="0,2,0,12">
                        <Run Text="{Binding CaptureFps}" Foreground="{Binding CaptureFpsForeground}" /><Run Text=" / " /><Run Text="{Binding EncodeFps}" Foreground="{Binding EncodeFpsForeground}" />
                    </TextBlock>
                    <TextBlock Text="Receive bitrate" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding Bitrate}" Foreground="White"
                               FontSize="22" Margin="0,2,0,12" />
                    <TextBlock Text="Sender bitrate (source)" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding SenderBitrate}" Foreground="White"
                               TextWrapping="Wrap" Margin="0,2,0,12" />
                    <TextBlock Text="Packets received" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding PacketsReceived}" Foreground="White"
                               FontSize="18" Margin="0,2,0,12" />
                    <TextBlock Text="Data received" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding BytesReceived}" Foreground="White"
                               FontSize="18" Margin="0,2,0,12" />
                    <TextBlock Text="Queue drops" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding PacketsDropped}" Foreground="White"
                               FontSize="18" Margin="0,2,0,12" />
                    <TextBlock Text="Queue drop rate" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding QueueDropRate}" Foreground="White"
                               FontSize="18" Margin="0,2,0,12" />
                    <TextBlock Text="Resolution" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding VideoSize}" Foreground="White"
                               FontSize="18" Margin="0,2,0,12" />
                    <TextBlock Text="Session duration" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding SessionDuration}" Foreground="White"
                               FontSize="18" Margin="0,2,0,12" />
                    <TextBlock x:Name="MetricsAvailabilityText"
                               Text="Waiting for RTSP source statistics."
                               Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Padding="12,8"
                Background="#1F2937" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Connection:" Foreground="#94A3B8" />
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="White"
                           Margin="6,0,24,0" />
                <TextBlock Text="Video:" Foreground="#94A3B8" />
                <TextBlock Text="{Binding VideoSize}" Foreground="White"
                           Margin="6,0,24,0" />
                <TextBlock Text="Receiver:" Foreground="#94A3B8" />
                <TextBlock x:Name="ReceiverTypeText" Text="WebRTC / WebView2" Foreground="White"
                           Margin="6,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
