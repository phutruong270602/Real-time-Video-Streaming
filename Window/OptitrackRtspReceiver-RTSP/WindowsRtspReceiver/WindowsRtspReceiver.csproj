<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NativeBuildDirectory>$(MSBuildProjectDirectory)\native-build</NativeBuildDirectory>
    <FFmpegRoot Condition="'$(FFmpegRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\IncepIT-TECSWING-Bay-Camera-64bit\OptitrackCameraDLL\packages\ffmpeg</FFmpegRoot>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="App\App.xaml" />
    <ApplicationDefinition Include="App\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\WindowsVideoReceiver\Streaming\receiver.html"
          Link="Streaming\receiver.html"
          CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\WindowsVideoReceiver\Network\SignalingServer.cs"
             Link="Network\SignalingServer.cs" />
    <Compile Include="..\..\WindowsVideoReceiver\Network\BonjourServiceAdvertiser.cs"
             Link="Network\BonjourServiceAdvertiser.cs" />
    <None Include="..\..\WindowsVideoReceiver\SetupFirewall.ps1"
          Link="SetupFirewall.ps1"
          CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <Target Name="BuildNativeRtspReceiver" AfterTargets="Build">
    <Exec Command="cmake -S &quot;$(MSBuildProjectDirectory)\..&quot; -B &quot;$(NativeBuildDirectory)&quot; -A x64 -DFFMPEG_ROOT=&quot;$(FFmpegRoot)&quot;" />
    <Exec Command="cmake --build &quot;$(NativeBuildDirectory)&quot; --config $(Configuration) --target optitrack_rtsp_native" />
    <Copy SourceFiles="$(NativeBuildDirectory)\$(Configuration)\OptitrackRtspNative.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
