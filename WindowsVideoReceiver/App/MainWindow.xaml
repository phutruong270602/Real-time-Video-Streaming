<Window x:Class="WindowsVideoReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowsVideoReceiver.Views"
        mc:Ignorable="d"
        Title="Windows Video Receiver" Height="760" Width="1280"
        MinHeight="600" MinWidth="1000" Background="#111827">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <views:VideoPlayerView x:Name="VideoPlayer" Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" />

        <Border Grid.Row="0" Grid.Column="1" Margin="0,0,12,12" Padding="16"
                Background="#1F2937" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Streaming Configuration" Foreground="White"
                           FontSize="17" FontWeight="SemiBold" Margin="0,0,0,24" />
                <TextBlock Text="Resolution" Foreground="#CBD5E1" />
                <ComboBox IsEnabled="False" Margin="0,8,0,18">
                    <ComboBoxItem Content="Waiting for iPhone capabilities" IsSelected="True" />
                </ComboBox>
                <TextBlock Text="Frame rate" Foreground="#CBD5E1" />
                <ComboBox IsEnabled="False" Margin="0,8,0,18">
                    <ComboBoxItem Content="Waiting for iPhone capabilities" IsSelected="True" />
                </ComboBox>
                <TextBlock Text="Bitrate" Foreground="#CBD5E1" />
                <Slider IsEnabled="False" Minimum="2" Maximum="30" Value="15"
                        Margin="0,10,0,0" />
                <TextBlock Text="15 Mbps" Foreground="#94A3B8"
                           HorizontalAlignment="Right" Margin="0,2,0,20" />
                <Button Content="Start" IsEnabled="False" Margin="0,0,0,8" />
                <Button Content="Stop" IsEnabled="False" />
                <TextBlock Text="Controls become available when signaling is implemented."
                           Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="2" Padding="16" Background="#1F2937" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Performance Monitoring" Foreground="White"
                           FontSize="17" FontWeight="SemiBold" Margin="0,0,0,24" />
                <TextBlock Text="Receive FPS" Foreground="#94A3B8" />
                <TextBlock Text="--" Foreground="White" FontSize="22" Margin="0,2,0,18" />
                <TextBlock Text="Bitrate" Foreground="#94A3B8" />
                <TextBlock Text="--" Foreground="White" FontSize="22" Margin="0,2,0,18" />
                <TextBlock Text="Packet loss" Foreground="#94A3B8" />
                <TextBlock Text="--" Foreground="White" FontSize="22" Margin="0,2,0,18" />
                <TextBlock Text="RTT" Foreground="#94A3B8" />
                <TextBlock Text="--" Foreground="White" FontSize="22" Margin="0,2,0,18" />
                <TextBlock Text="Statistics become available when WebRTC is implemented."
                           Foreground="#94A3B8" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Padding="12,8"
                Background="#1F2937" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Connection:" Foreground="#94A3B8" />
                <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" Margin="6,0,24,0" />
                <TextBlock Text="WebView2 bridge:" Foreground="#94A3B8" />
                <TextBlock Text="{Binding BridgeStatus}" Foreground="White" Margin="6,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
